APP_NAME="Balai ti Arjud"
APP_ENV=local
# Leave empty and run `php artisan key:generate`. Never commit a real key: it
# decrypts session data and signed URLs, so a published key is a published secret.
APP_KEY=
# Off in the template on purpose: copying this file to `.env` unchanged must never
# ship stack traces to production. Turn it on locally only (see NFR-21).
APP_DEBUG=false
APP_TIMEZONE=UTC
# The deployed site root, with no trailing slash — InfinityFree serves the app
# from the account's public_html, e.g. https://youraccount.infinityfreeapp.com.
#
# Set this on the server. It is not cosmetic: CSS, JavaScript and the compiled
# Tailwind bundle are all addressed with `asset()`, which builds from APP_URL. Left
# at localhost, a deployed site requests every stylesheet and script from
# localhost:8000 and renders unstyled with no JavaScript at all.
#
# Uploaded images are the exception — those use `url()` and follow whichever host
# the visitor actually asked for, so they survive a wrong APP_URL rather than
# breaking with the rest.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bta
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Encrypts session payloads at rest in the session store. A small CPU cost per
# request; it means a dumped `sessions` table is not a readable list of who is
# signed in. Leave this on in production (see NFR-07).
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Unset means "decide from the environment": `config/session.php` turns it on when
# APP_ENV=production and leaves it off locally, so a production deploy gets the
# Secure flag without breaking http://localhost on XAMPP (see NFR-05).
# Set it to true/false to override that inference.
# SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# `log` writes the message to storage/logs/laravel.log instead of sending it.
# That is the right default for a fresh checkout with no mail account, and the
# wrong one for anything that needs a real link delivered — the staff password
# reset is the case that bites: the flow reports "check your inbox" while the
# email has only ever been written to a log file.
#
# For local development, Mailtrap (https://mailtrap.io) is a safe sandbox: it
# catches everything without delivering to anyone's real inbox. Create a free
# inbox, copy its SMTP credentials below, then:
#
#     php artisan config:clear
#
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=null          # null for plain SMTP; `smtps` for implicit TLS
#   MAIL_HOST=smtp.mailtrap.io
#   MAIL_PORT=2525            # 587 with STARTTLS, or 465 for implicit TLS
#   MAIL_USERNAME=            # your Mailtrap username
#   MAIL_PASSWORD=            # your Mailtrap password
#
# The credentials are deliberately empty here. They belong in .env, which is
# git-ignored, and never in a committed file.
#
# PRODUCTION: GMAIL
#
# The salon sends over Gmail's SMTP relay. Gmail will not accept the account's
# normal password — it requires an App Password, which in turn requires 2-Step
# Verification to be turned on first. To create one:
# https://myaccount.google.com/apppasswords
#
# MAIL_USERNAME MUST be the address of the Google account the App Password was
# issued to — not merely an address the salon is known by.
#
# That distinction cost a long afternoon here. An App Password authenticates
# exactly one account, so pairing it with any other address fails with
# `535-5.7.8 Username and Password not accepted` no matter how correct the
# password is, and the message points at the password rather than the username,
# which sends you off generating more passwords that cannot work either. If a
# send is rejected, check that the App Password came from the account named in
# MAIL_USERNAME before making a new one.
#
# Paste the 16-character App Password into MAIL_PASSWORD in `.env`, then run
# `php artisan config:clear`. It is left blank here on purpose: this file is
# committed, and a Gmail App Password is a live credential for a live mailbox.
#
# MAIL_FROM_ADDRESS may differ from MAIL_USERNAME only when the From address is a
# verified alias or "send as" address on the authenticated account. If it is not,
# Gmail rewrites the sender to the authenticated mailbox — so if the salon's
# public address should appear on customer emails, add it as an alias on that
# Google account rather than just setting it here.
MAIL_MAILER=smtp
MAIL_SCHEME=null
# `tls` = STARTTLS on port 587, `ssl` = implicit TLS on port 465.
# Laravel 11 reads `scheme`, not `encryption`; config/mail.php maps this onto it.
MAIL_ENCRYPTION=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# The Google account that OWNS the App Password. Never commit a real address or
# password here — supply both from your own `.env`. A Google App Password
# authenticates exactly one mailbox, so this must be the mailbox the credential
# was issued to, which is usually NOT the address the salon is known by.
MAIL_USERNAME=""
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="balaitiarjud@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
