/.phpunit.cache
/node_modules
/public/build
/public/hot
# The uploads directory is served directly (see the `public` disk in
# config/filesystems.php), so the folders themselves must exist in a fresh
# checkout or an upload has nowhere to go and every image 404s.
#
# The folders are committed; what goes in them is not. Each one carries its own
# .gitignore, which is what makes that possible: git cannot track an empty
# directory, so without a placeholder file there would be nothing to check out.
/public/storage/*
!/public/storage/.gitignore
!/public/storage/*/
!/public/storage/*/.gitignore
# Generated CSV exports. The report feature streams these to the browser rather
# than writing them to disk, so anything here is a leftover from an older
# implementation — and because the directory sits under /public it is web
# reachable, so a stale export is a copy of the data served to anyone.
/public/reports
/storage/*.key
/storage/pail
/vendor
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/auth.json
/.fleet
/.idea
/.nova
/.vscode
/.zed

# Dev-server supervisor runtime files (see dev-up.bat / dev-down.bat)
/storage/dev-supervisor.pid
/storage/dev-supervisor.stop
/storage/dev-server.ready

# Local backups taken by hand before editing opencode's own config. These carry
# a full node_modules copy (52 MB), so committing one would put that weight in
# the history permanently — git keeps a blob forever, even after the file is
# deleted again.
# Only the live config is tracked; a backup of it is a local artefact.
/.opencode.bak/
/opencode.json.bak
